{
  "name": "emr-bridge",
  "version": "2.1.0",
  "description": "Allows you to easily give access to main methods from the renderer process",
  "main": "esm/entries/index.js",
  "type": "module",
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "compile": "npm run clean && tsc --project ./tsconfig.json && tsc --project ./tsconfig.cjs.json && node ./scripts/write-cjs-package.mjs",
    "typecheck": "tsc --project ./tsconfig.test.json",
    "test": "node --import ./test/setup.mjs --test \"test/*.test.ts\"",
    "pack": "npm run compile && npm pack"
  },
  "types": "esm/entries/index.d.ts",
  "files": [
    "esm",
    "cjs"
  ],
  "typesVersions": {
    "*": {
      ".": [
        "./esm/entries/index.d.ts"
      ],
      "./cjs": [
        "./cjs/entries/index.d.ts"
      ],
      "./main": [
        "./esm/entries/main.d.ts"
      ],
      "./renderer": [
        "./esm/entries/renderer.d.ts"
      ],
      "./preload": [
        "./esm/entries/preload.d.ts"
      ],
      "./cjs/main": [
        "./cjs/entries/main.d.ts"
      ],
      "./cjs/renderer": [
        "./cjs/entries/renderer.d.ts"
      ],
      "./cjs/preload": [
        "./cjs/entries/preload.d.ts"
      ]
    }
  },
  "exports": {
    ".": "./esm/entries/index.js",
    "./cjs": "./cjs/entries/index.js",
    "./package.json": "./package.json",
    "./main": "./esm/entries/main.js",
    "./renderer": "./esm/entries/renderer.js",
    "./preload": "./esm/entries/preload.js",
    "./cjs/main": "./cjs/entries/main.js",
    "./cjs/renderer": "./cjs/entries/renderer.js",
    "./cjs/preload": "./cjs/entries/preload.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VerZsuT/emr-bridge.git"
  },
  "keywords": [
    "electron",
    "ipc"
  ],
  "author": "VerZsuT",
  "license": "MIT",
  "peerDependencies": {
    "electron": ">=40.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
